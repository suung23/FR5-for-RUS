# Copy to `.env.local` and edit. Vite only exposes VITE_-prefixed variables.
#
# The default transport is `simulation`, which opens no sockets. Point this at
# real hardware only when a telemetry publisher actually exists on the network:
# the FR5 controller does not serve any of these protocols by itself.

VITE_ROBOT_HOST=192.168.58.3

# websocket | http | rosbridge | simulation
VITE_ROBOT_TELEMETRY_TRANSPORT=simulation

# --- websocket -------------------------------------------------------------
# A server pushing JSON RobotTelemetry frames.
# VITE_ROBOT_TELEMETRY_TRANSPORT=websocket
# VITE_ROBOT_TELEMETRY_URL=ws://192.168.58.3:9091/telemetry

# --- http ------------------------------------------------------------------
# Polled GET returning one RobotTelemetry document.
# VITE_ROBOT_TELEMETRY_TRANSPORT=http
# VITE_ROBOT_TELEMETRY_URL=http://192.168.58.3:8080/telemetry
# VITE_WRENCH_URL=http://192.168.58.3:8080/wrench
# VITE_HTTP_POLL_MS=100

# --- rosbridge -------------------------------------------------------------
# Requires `ros2 launch rosbridge_server rosbridge_websocket_launch.xml`
# running on a machine with the fr5 stack. This is the transport that fits the
# existing ROS 2 nodes.
# VITE_ROBOT_TELEMETRY_TRANSPORT=rosbridge
# VITE_ROBOT_TELEMETRY_URL=ws://localhost:9090
# VITE_ROS_JOINT_TOPIC=/fr5_right/joint_states
# VITE_ROS_WRENCH_TOPIC=/fr5_right/wrench

# --- thresholds ------------------------------------------------------------
# Defaults mirror fr5_control/config/probe.yaml. Keep them in step with it.
# VITE_CONTACT_ENTER_N=7.0
# VITE_CONTACT_RELEASE_N=0.2
# VITE_WARN_FORCE_N=6.0
# VITE_MAX_FORCE_N=7.0
# VITE_NORMAL_FORCE_SIGN=-1.0
