# Copy to `.env.local` and edit. Vite only exposes VITE_-prefixed variables.
#
# The default is the telemetry bridge on this workstation:
#
#   ros2 run fr5_control telemetry_bridge
#
# It subscribes to the Phase 0 stack's own topics and republishes them in this
# console's contract. With it running, the console follows the real robot; with
# it stopped, the console shows NO TELEMETRY and a still arm. It never invents
# motion — a monitor that moves on its own is worse than a blank one.

VITE_ROBOT_HOST=192.168.58.3

# websocket | http | rosbridge | simulation
VITE_ROBOT_TELEMETRY_TRANSPORT=websocket
VITE_ROBOT_TELEMETRY_URL=ws://localhost:8765

# --- bridge options --------------------------------------------------------
# Read the PX6D directly over USB instead of through the controller topic.
# Our sensor is the USB variant, so the controller's ft_sensor_data is empty
# and this is the only real force path:
#
#   ros2 run fr5_control telemetry_bridge --ros-args \
#     -p bridge.px6d_port:=/dev/ttyACM0
#
# Serial access needs the dialout group:  sg dialout -c "ros2 run ..."

# --- rosbridge -------------------------------------------------------------
# An alternative to the bridge if rosbridge_suite is installed (it is not, on
# this workstation). Same topics, generic transport.
# VITE_ROBOT_TELEMETRY_TRANSPORT=rosbridge
# VITE_ROBOT_TELEMETRY_URL=ws://localhost:9090
# VITE_ROS_JOINT_TOPIC=/fr5_right/joint_states
# VITE_ROS_WRENCH_TOPIC=/fr5_right/wrench

# --- http ------------------------------------------------------------------
# VITE_ROBOT_TELEMETRY_TRANSPORT=http
# VITE_ROBOT_TELEMETRY_URL=http://localhost:8080/telemetry
# VITE_WRENCH_URL=http://localhost:8080/wrench
# VITE_HTTP_POLL_MS=100

# --- simulation ------------------------------------------------------------
# Generated telemetry for reviewing the interface without hardware. Every panel
# labels it. Must be asked for explicitly; it is never a default.
# VITE_ROBOT_TELEMETRY_TRANSPORT=simulation

# --- thresholds ------------------------------------------------------------
# Defaults mirror fr5_control/config/probe.yaml. Keep them in step with it.
# VITE_CONTACT_ENTER_N=7.0
# VITE_CONTACT_RELEASE_N=0.2
# VITE_WARN_FORCE_N=6.0
# VITE_MAX_FORCE_N=7.0
# VITE_NORMAL_FORCE_SIGN=-1.0
