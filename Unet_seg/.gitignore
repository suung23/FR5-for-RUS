# Byte-compiled / cache
*.pyc
__pycache__/
.pytest_cache/
.ruff_cache/

# Datasets and generated artefacts.
# Leading slash matters: a bare "data/" would also exclude the rus_perception/data/ package.
/data/*
# 2026-09-10: 팬텀 라벨링 데이터셋 중 작은 것만 담는다 — manifest, 라벨 큐, 큐 프레임 PNG(to_label/), 사람이 그린 masks/.
# images/ (전체 프레임 PNG, ~500 MB) 는 원시 세션(imu_bench/logs) 에서 1 분이면 재생성:
#   python scripts/prepare_phantom_sessions.py --per-session 15
!/data/phantom_c10ur/
/data/phantom_c10ur/images/
/data/phantom_c10ur/masks/progress.json
# 2026-09-10: 파생물은 담지 않는다 — 사람이 그린 masks/ 와 라벨 큐, 접촉 실측만 남긴다.
# 학습 매니페스트와 의사라벨은 scripts/phantom_training_sets.py 로 언제든 다시 만든다:
#   python scripts/phantom_training_sets.py sets   --run runs/<이전 추론>
#   python scripts/phantom_training_sets.py export --run runs/<최종 추론>
/data/phantom_c10ur/masks_final/
/data/phantom_c10ur/pseudo_*/
/data/phantom_c10ur/manifest_masked.csv
/data/phantom_c10ur/manifest_train.csv
/data/phantom_c10ur/manifest_finetune*.csv
/data/phantom_c10ur/manifest_selftrain*.csv
/data/phantom_c10ur/contact_bands.csv
/data/phantom_c10ur/_review/
/checkpoints/
/runs/

# Model weights and exports
*.pth
*.pt
*.onnx
*.onnx.data

# Environments and editors
venv/
.venv/
.idea/
.vscode/

# Third-party logging
wandb/
